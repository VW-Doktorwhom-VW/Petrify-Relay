<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.2.4.0</Version>
    <AssemblyVersion>1.2.4.0</AssemblyVersion>
    <FileVersion>1.2.4.0</FileVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.10.6" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Model" Version="10.10.6" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- node is shipped gzip-compressed so the DLL stays under GitHub's 100 MB file limit -->
    <EmbeddedResource Include="Resources\node.gz" />
    <EmbeddedResource Include="Resources\server.mjs" />
    <EmbeddedResource Include="Resources\party-guest.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
